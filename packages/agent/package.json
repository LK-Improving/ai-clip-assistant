{
  "name": "@miaoma/agent",
  "version": "0.1.0",
  "description": "AI 智能体引擎：@langchain/langgraph StateGraph 编排（10 节点流水线）+ @langchain/core 模型抽象与 Provider 适配器（模块 2.x 实现）",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.13",
    "@miaoma/video-project": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
